<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>GuttyRL.Program</StartupObject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GuttyTECH_RL</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- WPF text shaping requires full globalization data. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <Product>GUTTYTECH RL INI Optimizer</Product>
    <AssemblyTitle>GUTTYTECH RL INI Optimizer</AssemblyTitle>
    <Company>GUTTYTECH</Company>
    <Version>24.2.3</Version>
    <FileVersion>24.2.3.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Sem trimming: PublishTrimmed quebrava startup em varios PCs (fecha na hora). -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Sem compressao no bundle: menos falso-positivo de AV na 1a extracao. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="embed-bundle.zip" Condition="Exists('embed-bundle.zip')">
      <LogicalName>GuttyRL.embed-bundle.zip</LogicalName>
    </EmbeddedResource>
    <Resource Include="Assets\gutty-avatar.png" />
  </ItemGroup>

  <Target Name="BuildEmbedBundle" BeforeTargets="BeforeBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build_embed_bundle.ps1&quot; -Root &quot;$(MSBuildProjectDirectory)\..&quot;" />
  </Target>

</Project>
